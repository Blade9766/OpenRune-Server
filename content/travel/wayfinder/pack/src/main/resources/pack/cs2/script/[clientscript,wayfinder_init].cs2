$id = ~wayfinder_box($p, $id, 138, 44, 184, 20, 2);
$id = ~wayfinder_icon($p, $id, 142, 48, 12, 12, wayfinder_icon_search);
$id = ~wayfinder_box($p, $id, 138, 68, 184, 18, 0);
$id = ~wayfinder_box($p, $id, 330, 40, 174, 250, 2);
$id = ~wayfinder_line($p, $id, 337, 63, 160, 1, 0xc8a050);
