[proc,wayfinder_button](component $component, string $label, int $colour)
cc_deleteall($component);
def_int $width = if_getwidth($component);
def_int $height = if_getheight($component);
def_int $next = ~options_button_off($component, 0);
cc_create($component, ^iftype_text, $next);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($width, $height, ^setsize_abs, ^setsize_abs);
cc_settextfont(p12_full);
cc_setcolour($colour);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settext($label);
if ($colour = 0x9f9f9f) {
    if_setonmouseover(null, $component);
    if_setonmouseleave(null, $component);
} else {
    if_setonmouseover("cc_colour_swapper(event_com, cc_getid, 16777215)", $component);
    if_setonmouseleave("cc_colour_swapper(event_com, cc_getid, $colour)", $component);
}
