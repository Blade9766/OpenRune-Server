[proc,wayfinder_line](component $layer, int $id, int $x, int $y, int $w, int $h, int $colour)(int)
cc_create($layer, ^iftype_rectangle, $id);
cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($w, $h, ^setsize_abs, ^setsize_abs);
cc_setfill(true);
cc_setcolour($colour);
return(calc($id + 1));
