[proc,wayfinder_border](component $layer, int $id, int $x, int $y, int $w, int $h, graphic $tl, graphic $tr, graphic $bl, graphic $br, graphic $l, graphic $t, graphic $r, graphic $b)(int)
cc_create($layer, ^iftype_graphic, $id);
cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(9, 9, ^setsize_abs, ^setsize_abs);
cc_setgraphic($tl);
cc_create($layer, ^iftype_graphic, calc($id + 1));
cc_setposition(calc($x + $w - 9), $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(9, 9, ^setsize_abs, ^setsize_abs);
cc_setgraphic($tr);
cc_create($layer, ^iftype_graphic, calc($id + 2));
cc_setposition($x, calc($y + $h - 9), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(9, 9, ^setsize_abs, ^setsize_abs);
cc_setgraphic($bl);
cc_create($layer, ^iftype_graphic, calc($id + 3));
cc_setposition(calc($x + $w - 9), calc($y + $h - 9), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(9, 9, ^setsize_abs, ^setsize_abs);
cc_setgraphic($br);
cc_create($layer, ^iftype_graphic, calc($id + 4));
cc_setposition($x, calc($y + 9), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(9, calc($h - 18), ^setsize_abs, ^setsize_abs);
cc_setgraphic($l);
cc_settiling(true);
cc_create($layer, ^iftype_graphic, calc($id + 5));
cc_setposition(calc($x + 9), $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($w - 18), 9, ^setsize_abs, ^setsize_abs);
cc_setgraphic($t);
cc_settiling(true);
cc_create($layer, ^iftype_graphic, calc($id + 6));
cc_setposition(calc($x + $w - 9), calc($y + 9), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(9, calc($h - 18), ^setsize_abs, ^setsize_abs);
cc_setgraphic($r);
cc_settiling(true);
cc_create($layer, ^iftype_graphic, calc($id + 7));
cc_setposition(calc($x + 9), calc($y + $h - 9), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($w - 18), 9, ^setsize_abs, ^setsize_abs);
cc_setgraphic($b);
cc_settiling(true);
return(calc($id + 8));
