[clientscript,wayfinder_draw_list](component $list, component $scrollbar, string $rows, int $selected, int $resetscroll)
cc_deleteall($list);
def_int $width = calc(if_getwidth($list) - 8);
def_int $row = 0;
def_int $start = 0;
def_int $end = string_indexof_string($rows, "|", 0);
def_string $name = "";
def_int $colour = 0xffffff;
// Rows are '|'-terminated labels; a row's component id is its index, which the server maps back.
while ($end >= 0) {
    $name = substring($rows, $start, $end);
    $colour = 0xffffff;
    if ($row = $selected) {
        $colour = 0xffff00;
    }
    cc_create($list, ^iftype_text, $row);
    cc_setposition(4, calc($row * 18), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize($width, 18, ^setsize_abs, ^setsize_abs);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    cc_settextshadow(true);
    cc_settextfont(p11_full);
    cc_setcolour($colour);
    cc_settext($name);
    cc_setop(1, "Select");
    cc_setopbase(append("<col=ff9040>", $name));
    cc_setonmouseover("cc_colour_swapper(event_com, event_comsubid, 16776960)");
    cc_setonmouseleave("cc_colour_swapper(event_com, event_comsubid, $colour)");
    $row = calc($row + 1);
    $start = calc($end + 1);
    $end = string_indexof_string($rows, "|", $start);
}
if_setscrollsize(0, calc($row * 18), $list);
if ($resetscroll = 1) {
    if_setscrollpos(0, 0, $list);
}
if ($scrollbar ! null) {
    ~scrollbar_vertical($scrollbar, $list, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
}
