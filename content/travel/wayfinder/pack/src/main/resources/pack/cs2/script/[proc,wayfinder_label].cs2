[proc,wayfinder_label](component $layer, int $id, int $x, int $y, int $w, int $h, string $text, graphic $font, int $colour, int $halign)(int)
cc_create($layer, ^iftype_text, $id);
cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($w, $h, ^setsize_abs, ^setsize_abs);
cc_settextfont($font);
cc_settextshadow(true);
cc_settextalign($halign, ^settextalign_centre, 0);
cc_setcolour($colour);
cc_settext($text);
return(calc($id + 1));
