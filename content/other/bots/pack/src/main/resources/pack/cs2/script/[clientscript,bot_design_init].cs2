[clientscript,bot_design_init](string $title, string $note)
cc_deleteall(player_design:frame);
~steelborder(player_design:frame, $title, 1);
if_sethide(true, player_design:player);
def_string $apply = "Apply";
def_boolean $flip = false;
cc_deleteall(player_design:confirm);
def_int $next = ~v2_stone_button_filled(player_design:confirm);
cc_create(player_design:confirm, ^iftype_text, $next);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_setcolour(^white);
cc_settextshadow(true);
cc_settextfont(p12_full);
cc_settext($apply);
if_setop(1, $apply, player_design:confirm);
if_setonmouseleave("player_design_button_hover(player_design:confirm, 0, $apply, $flip)", player_design:confirm);
if_setonmouserepeat("player_design_button_hover(player_design:confirm, 1, $apply, $flip)", player_design:confirm);
cc_deleteall(player_design:main);
cc_create(player_design:main, ^iftype_text, 0);
cc_setposition(172, 96, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(136, 66, ^setsize_abs, ^setsize_abs);
cc_settextfont(p11_full);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 13);
cc_setcolour(0xc8b48c);
cc_settextshadow(true);
cc_settext($note);
~bot_design_button(1, 168, "Randomize");
~bot_design_button(4, 200, "Reset");
~bot_design_button(7, 232, "Cancel");
