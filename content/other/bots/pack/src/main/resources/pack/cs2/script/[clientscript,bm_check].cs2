[clientscript,bm_check](component $component, int $checked, string $label)
cc_deleteall($component);
cc_create($component, ^iftype_graphic, 0);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(if_getwidth($component), if_getheight($component), ^setsize_abs, ^setsize_abs);
if ($checked = 1) {
    cc_setgraphic("checkbox,2");
} else {
    cc_setgraphic("checkbox,1");
}
if_clearops($component);
if_setop(1, "Toggle", $component);
if_setopbase("<col=ff9040><$label></col>", $component);
