[[interface]]
name = "interface.bot_status"
width = 512
height = 334
on_load = ["clientscript.bot_status_init", "component.bot_status:border"]

[[component]]
name = "border"
type = "layer"
width = 512
height = 334
no_click_through = true

[[component]]
name = "head_name"
type = "text"
x = 10
y = 42
width = 84
height = 16
text = "Bot"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_role"
type = "text"
x = 96
y = 42
width = 62
height = 16
text = "Role"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_state"
type = "text"
x = 160
y = 42
width = 110
height = 16
text = "State"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_inv"
type = "text"
x = 272
y = 42
width = 36
height = 16
text = "Inv"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_banked"
type = "text"
x = 310
y = 42
width = 56
height = 16
text = "Banked"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_threshold"
type = "text"
x = 368
y = 42
width = 48
height = 16
text = "Sell at"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_listings"
type = "text"
x = 418
y = 42
width = 30
height = 16
text = "GE"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

[[component]]
name = "head_coins"
type = "text"
x = 450
y = 42
width = 52
height = 16
text = "Coins"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"

