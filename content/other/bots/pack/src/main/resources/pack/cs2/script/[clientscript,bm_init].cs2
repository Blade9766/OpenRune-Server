[clientscript,bm_init]
~steelborder(bot_manager:frame, "Bot Manager", 0);
cc_deleteall(bot_manager:side_box);
~thinbox(bot_manager:side_box, 0);
cc_deleteall(bot_manager:main_box);
~thinbox(bot_manager:main_box, 0);
cc_deleteall(bot_manager:foot_box);
~thinbox(bot_manager:foot_box, 0);
cc_deleteall(bot_manager:mh_card0_box);
~thinbox(bot_manager:mh_card0_box, 0);
cc_deleteall(bot_manager:mh_card1_box);
~thinbox(bot_manager:mh_card1_box, 0);
cc_deleteall(bot_manager:mh_card2_box);
~thinbox(bot_manager:mh_card2_box, 0);
cc_deleteall(bot_manager:ed_box);
~thinbox(bot_manager:ed_box, 0);
cc_deleteall(bot_manager:hi_card0_box);
~thinbox(bot_manager:hi_card0_box, 0);
cc_deleteall(bot_manager:hi_card1_box);
~thinbox(bot_manager:hi_card1_box, 0);
cc_deleteall(bot_manager:hi_card2_box);
~thinbox(bot_manager:hi_card2_box, 0);
cc_deleteall(bot_manager:hi_card3_box);
~thinbox(bot_manager:hi_card3_box, 0);
cc_deleteall(bot_manager:hd_box);
~thinbox(bot_manager:hd_box, 0);
cc_deleteall(bot_manager:ov_card0_box);
~thinbox(bot_manager:ov_card0_box, 0);
cc_deleteall(bot_manager:ov_card1_box);
~thinbox(bot_manager:ov_card1_box, 0);
cc_deleteall(bot_manager:ov_card2_box);
~thinbox(bot_manager:ov_card2_box, 0);
cc_deleteall(bot_manager:ov_card3_box);
~thinbox(bot_manager:ov_card3_box, 0);
cc_deleteall(bot_manager:ov_m_box);
~thinbox(bot_manager:ov_m_box, 0);
cc_deleteall(bot_manager:rd_box);
~thinbox(bot_manager:rd_box, 0);
cc_deleteall(bot_manager:ip_box);
~thinbox(bot_manager:ip_box, 0);
~searchbar_create(bot_manager:ip_searchbar, null);
%settings_search_string = "";
~bm_search_idle;
