[proc,transmog_slot](component $component, int $slot, int $selected, int $hidden)
def_obj $obj = inv_getobj(transmog_slots, $slot);
def_string $name = ~transmog_slot_name($slot);
cc_deleteall($component);
cc_create($component, ^iftype_graphic, 0);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setsize(36, 36, ^setsize_abs, ^setsize_abs);
cc_setgraphic("miscgraphics,0");
if ($obj ! null) {
    $name = oc_name($obj);
    cc_create($component, ^iftype_graphic, 1);
    cc_setposition(2, 2, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setgraphicshadow(0x333333);
    cc_setoutline(1);
    cc_setobject_nonum($obj, 1);
} else {
    cc_create($component, ^iftype_graphic, 1);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
    cc_setgraphic(enum(int, graphic, enum_904, $slot));
    if (testbit($hidden, $slot) = 1) {
        cc_settrans(160);
        cc_create($component, ^iftype_text, 2);
        cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
        cc_setsize(36, 36, ^setsize_abs, ^setsize_abs);
        cc_settextfont(p11_full);
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
        cc_settextshadow(true);
        cc_setcolour(0xff0000);
        cc_settext("Hidden");
    }
}
if ($slot = $selected) {
    cc_create($component, ^iftype_rectangle, 3);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(36, 36, ^setsize_abs, ^setsize_abs);
    cc_setcolour(0xffff00);
    cc_setfill(false);
}
if_setopbase("<col=ff9040><$name></col>", $component);
