[[interface]]
name = "interface.cheat_panel"
width = 190
height = 261
on_load = ["clientscript.cheat_panel_init"]

[[component]]
name = "title"
type = "text"
y = 3
width = 190
height = 18
text = "Cheat Menu"
font = "bold"
h_align = "centre"
v_align = "center"
text_shadow = true
color = "#FF981F"

[[component]]
name = "close"
type = "layer"
x = 163
y = 7
width = 26
height = 23
options = ["Close"]

[[component]]
name = "on_header"
type = "text"
x = 136
y = 30
width = 21
height = 15
text = "On"
font = "small"
h_align = "centre"
v_align = "center"
text_shadow = true
color = "#FF981F"

[[component]]
name = "off_header"
type = "text"
x = 161
y = 30
width = 21
height = 15
text = "Off"
font = "small"
h_align = "centre"
v_align = "center"
text_shadow = true
color = "#FF981F"

[[component]]
